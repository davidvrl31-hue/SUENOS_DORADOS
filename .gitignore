# ============================================================
# SUEÑOS DORADOS — .gitignore global del monorepo
# ============================================================

# ===========================
# VARIABLES DE ENTORNO
# (contienen credenciales, nunca subir)
# ===========================
.env
.env.*
!.env.example
!.env.*.example

# ===========================
# DEPENDENCIAS
# ===========================
**/node_modules/
**/.pnp
**/.pnp.js

# Python
**/venv/
**/.venv/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/*.egg-info/
**/dist-info/

# ===========================
# BUILDS Y COMPILADOS
# ===========================
**/dist/
**/build/
**/.next/
**/out/
**/web-build/
**/tsconfig.tsbuildinfo
**/*.tsbuildinfo

# ===========================
# ARCHIVOS GENERADOS EN RUNTIME
# (facturas PDF, reportes Excel, etc.)
# ===========================
suenos-dorados-api/uploads/
suenos-dorados-escritorio/facturas/
suenos-dorados-escritorio/reportes/
suenos-dorados-escritorio/imagenes_app/

# ===========================
# EXPO / REACT NATIVE
# ===========================
**/.expo/
**/.metro-health-check*
**/expo-env.d.ts
**/*.orig.*

# Certificados y llaves nativas (no aplica en Expo managed, pero por si acaso)
**/*.jks
**/*.p8
**/*.p12
**/*.key
**/*.mobileprovision
**/.kotlin/

# ===========================
# LOGS
# ===========================
**/*.log
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===========================
# SISTEMA OPERATIVO
# ===========================
.DS_Store
Thumbs.db
desktop.ini
*.pem

# ===========================
# IDEs y EDITORES
# ===========================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.suo
*.user

# ===========================
# TESTS Y COBERTURA
# ===========================
**/coverage/
**/.nyc_output/

# ===========================
# CACHÉ Y TEMPORALES
# ===========================
**/.temp/
**/.tmp/
**/.cache/
**/report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
